# You should NOT normally need to set this. The default flow is: run
# `npm run server`, and it walks you through `ant auth login` right there in
# the terminal, then logs you back out (and shuts itself down) at the next
# local midnight — no static, persistently-active credential involved. See
# CLAUDE.md. Only set ANTHROPIC_API_KEY here if you deliberately want a
# standing key instead of the daily login flow.
ANTHROPIC_API_KEY=

# Optional, defaults to 8787.
PORT=8787

# Hard daily cap (input + output tokens, combined) on Reflection-mode API
# usage. Requests are refused with HTTP 429 once this is hit, before the
# Anthropic API is ever called. Resets at local midnight. Optional, defaults
# to 20000 (roughly $0.10-$0.50 depending on the input/output mix at
# claude-opus-4-8 pricing).
TOKEN_BUDGET_DAILY=20000
